# ROP-Sahayak / ROP-Track Environment Configuration Template
# Copy this file to .env and fill in your private credentials locally.
# NEVER commit your actual .env file to GitHub.

# Server Configuration
HOST=127.0.0.1
PORT=8090
ENVIRONMENT=development

# Database & Cache (Optional / Production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rop_db
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tele-Ophthalmology Notification Gateway (Simulated in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_SANDBOX_NUMBER=
